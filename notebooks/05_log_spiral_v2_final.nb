Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", 
      RowBox[{"Sampling", "--"}]}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"thetaMin", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"thetaMax", "=", 
     RowBox[{"2", " ", "Pi"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wMin", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wMax", "=", "0.3"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"numTheta", "=", "200"}], ";", 
    RowBox[{"(*", 
     RowBox[{"adjust", " ", "smoothness", " ", "along", " ", "\[Theta]"}], 
     "*)"}], 
    RowBox[{"numW", "=", "20"}], ";", 
    RowBox[{"(*", 
     RowBox[{"adjust", " ", "smoothness", " ", "along", " ", "offset"}], 
     "*)"}], 
    RowBox[{"thetaValues", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"thetaMin", ",", "thetaMax", ",", "numTheta"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"wValues", "=", 
     RowBox[{"Subdivide", "[", 
      RowBox[{"wMin", ",", "wMax", ",", "numW"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "3", "D", " ", "points", " ", "for", " ", "all", " ", 
     "combinations", " ", "of", " ", "\[Theta]", " ", "and", " ", "w"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"points3D", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"X", "[", 
          RowBox[{"\[Theta]", ",", "w"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "thetaValues"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "wValues"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Export", " ", "to", " ", "CSV", " ", 
     RowBox[{"(", 
      RowBox[{"Inventor", "-", "friendly"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{
    "\"\<C:\\\\Users\\\\nevez\\\\OneDrive\\\\Documents\\\\Mathematica project\
\\\\spiral_3D_points.csv\>\"", ",", "points3D", ",", "\"\<CSV\>\""}], 
    "]"}]}]}]], "Input",
