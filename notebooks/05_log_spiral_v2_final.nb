Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Xu", "[", 
   RowBox[{"\[Theta]_", ",", "w_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"X", "[", 
      RowBox[{"\[Phi]", ",", "w"}], "]"}], ",", "\[Phi]"}], "]"}], "/.", 
   RowBox[{"\[Phi]", "\[Rule]", "\[Theta]"}]}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Xw", "[", 
    RowBox[{"\[Theta]_", ",", "w_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"X", "[", 
       RowBox[{"\[Theta]", ",", "\[Omega]"}], "]"}], ",", "\[Omega]"}], "]"}],
     "/.", 
    RowBox[{"\[Omega]", "\[Rule]", "w"}]}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SurfaceNormal", "[", 
    RowBox[{"\[Theta]_", ",", "w_"}], "]"}], ":=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Cross", "[", 
      RowBox[{
       RowBox[{"Xu", "[", 
        RowBox[{"\[Theta]", ",", "w"}], "]"}], ",", 
       RowBox[{"Xw", "[", 
        RowBox[{"\[Theta]", ",", "w"}], "]"}]}], "]"}], "/", 
     RowBox[{"Norm", "[", 
      RowBox[{"Cross", "[", 
       RowBox[{
        RowBox[{"Xu", "[", 
         RowBox[{"\[Theta]", ",", "w"}], "]"}], ",", 
        RowBox[{"Xw", "[", 
         RowBox[{"\[Theta]", ",", "w"}], "]"}]}], "]"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Xthick", "[", 
    RowBox[{"\[Theta]_", ",", "w_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"X", "[", 
     RowBox[{"\[Theta]", ",", "w"}], "]"}], "+", 
    RowBox[{
     RowBox[{"(", "t", ")"}], 
     RowBox[{"SurfaceNormal", "[", 
      RowBox[{"\[Theta]", ",", "w"}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", "0.05"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"Xthick", "[", 
      RowBox[{"\[Theta]", ",", "w", ",", 
       RowBox[{"h", "/", "2"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Theta]", ",", "0", ",", 
       RowBox[{"1.9", "Pi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"w", ",", "0", ",", "0.3"}], "}"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{"Orange", ",", 
        RowBox[{"Opacity", "[", "0.7", "]"}]}], "]"}]}], ",", 
     RowBox[{"Mesh", "\[Rule]", "None"}]}], "]"}], "*)"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"Xthick", "[", 
        RowBox[{"\[Theta]", ",", "w", ",", 
         RowBox[{"h", "/", "2"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Theta]", ",", "0", ",", 
         RowBox[{"1.9", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"w", ",", 
         RowBox[{"-", "0.1"}], ",", "0.1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"Directive", "[", 
         RowBox[{"Orange", ",", 
          RowBox[{"Opacity", "[", "0.6", "]"}]}], "]"}]}], ",", 
       RowBox[{"Mesh", "\[Rule]", "None"}]}], "]"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"Xthick", "[", 
        RowBox[{"\[Theta]", ",", "w", ",", 
