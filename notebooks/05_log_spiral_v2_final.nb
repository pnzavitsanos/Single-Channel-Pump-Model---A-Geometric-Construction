Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "b", ",", "\[Theta]"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Logarithmic", " ", "spiral"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"r", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"b", " ", "\[Theta]"}], "]"}], " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
      RowBox[{"a", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"b", " ", "\[Theta]"}], "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"First", " ", "derivative"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rp", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"r", "[", "\[Phi]", "]"}], ",", "\[Phi]"}], "]"}], "/.", 
     RowBox[{"\[Phi]", "\[Rule]", "\[Theta]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "Speed", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"speed", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"rp", "[", "\[Theta]", "]"}], ".", 
      RowBox[{"rp", "[", "\[Theta]", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Unit", " ", "tangent"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"T", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"rp", "[", "\[Theta]", "]"}], "/", 
      RowBox[{"speed", "[", "\[Theta]", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Derivative", " ", "of", " ", "the", " ", "tangent"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Tp", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"T", "[", "\[Phi]", "]"}], ",", "\[Phi]"}], "]"}], "/.", 
     RowBox[{"\[Phi]", "\[Rule]", "\[Theta]"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Unit", " ", "normal", " ", 
    RowBox[{"(", 
     RowBox[{"renamed", " ", "from", " ", 
      RowBox[{"N", "!"}]}], ")"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"NormalVec", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"Tp", "[", "\[Theta]", "]"}], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Tp", "[", "\[Theta]", "]"}], ".", 
        RowBox[{"Tp", "[", "\[Theta]", "]"}]}], "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Verify", " ", "orthogonality", " ", 
     RowBox[{"T", "\[CenterDot]", "N"}]}], "=", "0"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CheckOrthogonality", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"T", "[", "\[Theta]", "]"}], ".", 
     RowBox[{"NormalVec", "[", "\[Theta]", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Z", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Rot", "[", "\[CurlyPhi]_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], ",", 
        RowBox[{"-", 
         RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}]}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sin", "[", "\[CurlyPhi]", "]"}], ",", 
        RowBox[{"Cos", "[", "\[CurlyPhi]", "]"}], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"F", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Rot", "[", 
      RowBox[{"\[Theta]", "/", "2"}], "]"}], ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"NormalVec", "[", "\[Theta]", "]"}], ",", "0"}], "]"}], "+", 
       "Z"}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F", "[", "\[Theta]_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Sin", "[", 
       RowBox[{
        RowBox[{"Pi", "/", "4"}], "-", 
        RowBox[{"\[Theta]", "/", "8"}]}], "]"}]}], 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"NormalVec", "[", "\[Theta]", "]"}], ",", "0"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"Pi", "/", "4"}], "-", 
       RowBox[{"\[Theta]", "/", "8"}]}], "]"}], "Z"}]}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"F", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "v", "}"}], ",", 
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{
         RowBox[{"Rot", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], ".", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{"Take", "[", 
              RowBox[{
               RowBox[{"NormalVec", "[", "\[Theta]", "]"}], ",", "2"}], "]"}],
              ",", "0"}], "]"}], "+", "Z"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"v", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "}"}]}]}], "  ", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"enforce", " ", "z"}], "=", "1"}], "*)"}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"X", "[", 
    RowBox[{"\[Theta]_", ",", "w_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{"r", "[", "\[Theta]", "]"}], ",", "0"}], "]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"w", "/", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "4"}], "-", 
         RowBox[{"\[Theta]", "/", "8"}]}], "]"}]}], ")"}], " ", 
