Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Definitions", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f0", "[", "s_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "s"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"f1", "[", "s_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", " ", "Pi", " ", "s"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "Pi", " ", "s"}], "]"}]}], "-", 
        RowBox[{"1", "/", "2"}]}], ",", "s"}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Homotopy", " ", "H", 
      RowBox[{"(", 
       RowBox[{"s", ",", "t"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}], " ", "f0", 
       RowBox[{"(", "s", ")"}]}], "+", 
      RowBox[{"t", " ", "f1", 
       RowBox[{"(", "s", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"s_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "t"}], ")"}], " ", 
       RowBox[{"f0", "[", "s", "]"}]}], "+", 
      RowBox[{"t", " ", 
       RowBox[{"f1", "[", "s", "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Draw", " ", "a", " ", "curve", " ", "as", " ", "a", " ", "thick", " ", 
     "tube", " ", "for", " ", "clarity"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"curveGraphic", "[", 
      RowBox[{"cur_", ",", "col_", ",", 
       RowBox[{"pts_", ":", "200"}]}], "]"}], ":=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"cur", "[", "s", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Thickness", "[", "0.01", "]"}], ",", "col"}], "}"}]}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"PlotPoints", "\[Rule]", "pts"}], ",", 
       RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
       RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Static", " ", "display", " ", "of", " ", "the", " ", "two", " ", 
     "endpoint", " ", "curves"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"curveGraphic", "[", 
      RowBox[{"f0", ",", "Black"}], "]"}], ",", 
     RowBox[{"curveGraphic", "[", 
      RowBox[{"f1", ",", "Gray"}], "]"}], ",", 
     RowBox[{"Graphics3D", "[", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"Sphere", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "0.03"}], "]"}], 
        ",", "Blue", ",", 
        RowBox[{"Sphere", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", "0.03"}], "]"}]}], 
       "}"}], "]"}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Animated", " ", 
     RowBox[{"homotopy", ":", 
      RowBox[{
      "slider", " ", "moves", " ", "t", " ", "from", " ", "0", " ", "to", " ",
        "1"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Animate", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"curveGraphic", "[", 
          RowBox[{"f0", ",", "Black", ",", "120"}], "]"}], ",", 
         RowBox[{"curveGraphic", "[", 
          RowBox[{"f1", ",", "Gray", ",", "120"}], "]"}], ",", 
         RowBox[{"ParametricPlot3D", "[", 
          RowBox[{
           RowBox[{"H", "[", 
            RowBox[{"s", ",", "t"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"PlotStyle", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"Thick", ",", 
              RowBox[{"RGBColor", "[", 
               RowBox[{"0", ",", "0.6", ",", "0"}], "]"}]}], "}"}]}], ",", 
           RowBox[{"PlotPoints", "\[Rule]", "200"}], ",", 
           RowBox[{"Mesh", "\[Rule]", "None"}]}], "]"}], ",", 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", 
           RowBox[{"Red", ",", 
            RowBox[{"Sphere", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "0.03"}], "]"}],
             ",", 
            RowBox[{"(*", "A", "*)"}], "Blue", ",", 
            RowBox[{"Sphere", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", "0.03"}], "]"}],
             ",", 
            RowBox[{"(*", "B", "*)"}], 
            RowBox[{"Text", "[", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"\"\<t = \>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"NumberForm", "[", 
                   RowBox[{"t", ",", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "2"}], "}"}]}], "]"}], "]"}]}], ",", 
                "14"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"-", "1"}], ",", "1.05"}], "}"}]}], "]"}]}], "}"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
       RowBox[{"Axes", "\[Rule]", "True"}]}], "]"}], ",", 
