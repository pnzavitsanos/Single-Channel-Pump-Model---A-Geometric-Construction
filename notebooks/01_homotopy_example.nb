Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Original", " ", "curves"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f0", "[", "s_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "s"}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f1", "[", "s_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", "2"}], ")"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", " ", "Pi", " ", "s"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "2"}], ")"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "Pi", " ", "s"}], "]"}]}], "-", 
        RowBox[{"1", "/", "2"}]}], ",", "s"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Extract", " ", "xy", " ", "components"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"p1xy", "[", "s_", "]"}], ":=", 
     RowBox[{
      RowBox[{"f1", "[", "s", "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Polar", " ", "radius", " ", "and", " ", "angle", " ", "for", " ", "the", 
     " ", "xy", " ", "target", " ", "point"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"r", "[", "s_", "]"}], ":=", 
     RowBox[{"Norm", "[", 
      RowBox[{"p1xy", "[", "s", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"thetaStar", "[", "s_", "]"}], ":=", 
     RowBox[{"ArcTan", "@@", 
      RowBox[{"p1xy", "[", "s", "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Sweeper", " ", 
     RowBox[{"homotopy", ":", 
      RowBox[{
       RowBox[{"rotate", " ", "each", " ", "s"}], "-", 
       RowBox[{
       "level", " ", "point", " ", "by", " ", "angle", " ", "t", "*", 
        "thetaStar", 
        RowBox[{"(", "s", ")"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"s_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", "s", "]"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"t", " ", 
          RowBox[{"thetaStar", "[", "s", "]"}]}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"r", "[", "s", "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"t", " ", 
          RowBox[{"thetaStar", "[", "s", "]"}]}], "]"}]}], ",", "s"}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Visualization", " ", "helpers"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"curveGraphic", "[", 
      RowBox[{"cur_", ",", "col_"}], "]"}], ":=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"cur", "[", "s", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"s", ",", "0", ",", "1"}], "}"}], ",", 
