       RowBox[{"PlotPoints", "\[Rule]", "200"}], ",", 
       RowBox[{"Mesh", "\[Rule]", "None"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Animation", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Animate", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"(*", 
         RowBox[{"endpoint", " ", "curves"}], "*)"}], 
        RowBox[{
         RowBox[{"curveGraphic", "[", 
          RowBox[{"f0", ",", "Black"}], "]"}], ",", 
         RowBox[{"curveGraphic", "[", 
          RowBox[{"f1", ",", "Gray"}], "]"}], ",", 
         RowBox[{"(*", 
