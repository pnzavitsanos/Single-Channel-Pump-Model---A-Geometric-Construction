Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"a", ",", "b", ",", "\[Theta]"}], "]"}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Logarithmic", " ", "spiral"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"r", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"a", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"b", " ", "\[Theta]"}], "]"}], " ", 
       RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
      RowBox[{"a", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"b", " ", "\[Theta]"}], "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}], "}"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"First", " ", "derivative"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"rp", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"r", "[", "\[Phi]", "]"}], ",", "\[Phi]"}], "]"}], "/.", 
     RowBox[{"\[Phi]", "\[Rule]", "\[Theta]"}]}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", "Speed", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"speed", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{"rp", "[", "\[Theta]", "]"}], ".", 
      RowBox[{"rp", "[", "\[Theta]", "]"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Unit", " ", "tangent"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"T", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"rp", "[", "\[Theta]", "]"}], "/", 
      RowBox[{"speed", "[", "\[Theta]", "]"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Derivative", " ", "of", " ", "the", " ", "tangent"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Tp", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"T", "[", "\[Phi]", "]"}], ",", "\[Phi]"}], "]"}], "/.", 
     RowBox[{"\[Phi]", "\[Rule]", "\[Theta]"}]}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Unit", " ", "normal", " ", 
    RowBox[{"(", 
     RowBox[{"renamed", " ", "from", " ", 
      RowBox[{"N", "!"}]}], ")"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"NormalVec", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"Simplify", "[", 
     RowBox[{
      RowBox[{"Tp", "[", "\[Theta]", "]"}], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"Tp", "[", "\[Theta]", "]"}], ".", 
        RowBox[{"Tp", "[", "\[Theta]", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n",
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Verify", " ", "orthogonality", " ", 
     RowBox[{"T", "\[CenterDot]", "N"}]}], "=", "0"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CheckOrthogonality", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"T", "[", "\[Theta]", "]"}], ".", 
     RowBox[{"NormalVec", "[", "\[Theta]", "]"}]}], "]"}]}], 
  ";"}], "\n"}], "Input",
