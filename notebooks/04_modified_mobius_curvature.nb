Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Parameters", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"R", "=", "2"}], ";", 
    RowBox[{"(*", 
     RowBox[{"radius", " ", "of", " ", "central", " ", "circle"}], "*)"}], 
    RowBox[{"w", "=", "0.5"}], ";", 
    RowBox[{"(*", 
     RowBox[{"half", "-", 
      RowBox[{"width", " ", "of", " ", "the", " ", "strip"}]}], "*)"}], 
    RowBox[{"alpha", "=", "1.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "warping", " ", "factor", " ", "to", " ", "introduce", " ", "curvature"}],
     "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Parametric", " ", "equations", " ", "of", " ", "warped", " ", 
      "M\[ODoubleDot]bius"}], "-", 
     RowBox[{"like", " ", "strip"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"X", "[", 
      RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"R", "+", 
        RowBox[{"v", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"u", "/", "2"}], "]"}]}]}], ")"}], " ", 
      RowBox[{"Cos", "[", "u", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Y", "[", 
      RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"R", "+", 
        RowBox[{"v", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"u", "/", "2"}], "]"}]}]}], ")"}], " ", 
      RowBox[{"Sin", "[", "u", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Z", "[", 
      RowBox[{"u_", ",", "v_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"v", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"u", "/", "2"}], "]"}]}], "+", 
      RowBox[{"alpha", " ", 
       RowBox[{"v", "^", "2"}], " ", 
       RowBox[{"Sin", "[", "u", "]"}]}]}]}], ";", 
    RowBox[{"(*", 
     RowBox[{
     "warping", " ", "term", " ", "introduces", " ", "intrinsic", " ", 
      "curvature"}], "*)"}], 
    RowBox[{"(*", 
     RowBox[{"Plot", " ", "the", " ", "surface"}], "*)"}], 
    RowBox[{"ParametricPlot3D", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"X", "[", 
         RowBox[{"u", ",", "v"}], "]"}], ",", 
        RowBox[{"Y", "[", 
         RowBox[{"u", ",", "v"}], "]"}], ",", 
        RowBox[{"Z", "[", 
         RowBox[{"u", ",", "v"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"u", ",", "0", ",", 
        RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"v", ",", 
        RowBox[{"-", "w"}], ",", "w"}], "}"}], ",", 
      RowBox[{"PlotPoints", "\[Rule]", "100"}], ",", 
      RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
      RowBox[{"Lighting", "\[Rule]", "\"\<Neutral\>\""}], ",", 
      RowBox[{"AxesLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}], 
      ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"Directive", "[", 
        RowBox[{"Orange", ",", 
         RowBox[{"Specularity", "[", 
          RowBox[{"White", ",", "20"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"Boxed", "\[Rule]", "False"}]}], "]"}]}], "\n"}]}]], "Input",
