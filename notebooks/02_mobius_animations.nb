             RowBox[{"-", "0.3"}], ",", "0.3"}], "}"}], ",", 
           RowBox[{"Mesh", "\[Rule]", "None"}], ",", 
           RowBox[{"PlotStyle", "\[Rule]", 
            RowBox[{"Opacity", "[", "0.4", "]"}]}], ",", 
           RowBox[{"PlotPoints", "\[Rule]", "70"}]}], "]"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "Moving", " ", "fiber", " ", "at", " ", "angle", " ", 
           "\[CurlyPhi]"}], "*)"}], 
         RowBox[{"Graphics3D", "[", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Thick", ",", 
            RowBox[{"Line", "[", 
             RowBox[{"fiber", "[", "\[CurlyPhi]", "]"}], "]"}]}], "}"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"Boxed", "\[Rule]", "False"}], ",", 
       RowBox[{"Axes", "\[Rule]", "False"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[CurlyPhi]", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}], "\n"}]}]], "Input",
