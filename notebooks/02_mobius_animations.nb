Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Base", " ", "circle", " ", "on", " ", "the", " ", "xy"}], "-", 
    "plane"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"C0", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", "0"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Radial", " ", "unit", " ", "vector"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"R", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]", "]"}], ",", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], ",", "0"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Vertical", " ", "unit", " ", "vector"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Z", ":=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Rotating", " ", "fiber", " ", "direction", " ", "F", 
     RowBox[{"(", "\[Theta]", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"F", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], " ", 
       RowBox[{"R", "[", "\[Theta]", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"\[Theta]", "/", "2"}], "]"}], " ", "Z"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"M\[ODoubleDot]bius", " ", "embedding"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mobius", "[", 
      RowBox[{"\[Theta]_", ",", "w_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"C0", "[", "\[Theta]", "]"}], "+", 
      RowBox[{"w", " ", 
       RowBox[{"F", "[", "\[Theta]", "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Frame", " ", "vectors", " ", "at", " ", "angle", " ", "\[Theta]"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"frameArrows", "[", "\[Theta]_", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"C0", "[", "\[Theta]", "]"}], ",", 
          RowBox[{
           RowBox[{"C0", "[", "\[Theta]", "]"}], "+", 
           RowBox[{"0.5", " ", 
            RowBox[{"R", "[", "\[Theta]", "]"}]}]}]}], "}"}], "]"}], ",", 
       RowBox[{"(*", "radial", "*)"}], "Blue", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"C0", "[", "\[Theta]", "]"}], ",", 
          RowBox[{
           RowBox[{"C0", "[", "\[Theta]", "]"}], "+", 
           RowBox[{"0.5", " ", "Z"}]}]}], "}"}], "]"}], ",", 
       RowBox[{"(*", "vertical", "*)"}], "Green", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"C0", "[", "\[Theta]", "]"}], ",", 
          RowBox[{
           RowBox[{"C0", "[", "\[Theta]", "]"}], "+", 
           RowBox[{"0.7", " ", 
            RowBox[{"F", "[", "\[Theta]", "]"}]}]}]}], "}"}], "]"}]}], 
      "      ", 
      RowBox[{"(*", 
       RowBox[{"rotating", " ", "fiber"}], "*)"}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"Animate", "[", 
    RowBox[{
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"{", 
